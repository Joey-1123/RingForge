# RingForge Configuration
# Copy to .env and fill in your values

# Default export profile
DEFAULT_PROFILE=android

# Default duration in seconds
DEFAULT_DURATION=30

# Audio normalization (true/false)
NORMALIZE=true

# Apply fade in/out (true/false)
FADE=true

# Cache downloaded audio and analysis
CACHE=true

# Log level
LOG_LEVEL=INFO

# Export directory
EXPORT_DIR=exports

# Batch workers (default: CPU count)
BATCH_WORKERS=4
